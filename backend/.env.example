# development, production, or test. Default: development
NODE_ENV=development

# HTTP port. Default: 5001
PORT=5001

# MongoDB connection string
MONGO_URI=

# Optional. When set, the server uses this database instead of the one in MONGO_URI.
# Set it in development so the app and the demo seed do not use the original database.
MONGO_DB_NAME=

# Only read by scripts/seed-demo.js. Not required to start the server.
# At least 8 characters. Do not commit a real value.
DEMO_PASSWORD=

# Secret used to sign the session JWT. At least 32 characters in production.
JWT_SECRET_KEY=

# Stream Chat server key. Same Stream app as the frontend VITE_STREAM_API_KEY.
STREAM_API_KEY=

# Stream Chat server secret
STREAM_API_SECRET=

# Comma-separated browser origins allowed to call the API with credentials.
# Empty in development allows http://localhost:5173. Empty in production allows no cross-origin access.
FRONTEND_ORIGINS=

# Legacy single origin. Used only when FRONTEND_ORIGINS is empty.
FRONTEND_ORIGIN=

# Set to true to enforce Content-Security-Policy. Any other value keeps it report-only.
CSP_ENFORCE=false
